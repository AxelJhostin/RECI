# RECI — Variables de entorno para la demo
# Copiar este archivo a .env y completar los valores:
#   cp .env.example .env

# ── Proveedor de visión ───────────────────────────────────────────
# claude | gemini  (si no se define, usa Claude si hay ANTHROPIC_API_KEY)
VISION_API=claude

# ── Claude (recomendado para la demo) ─────────────────────────────
# Obtener key: https://console.anthropic.com/
# Mínimo de recarga: $5
ANTHROPIC_API_KEY=tu_api_key_aqui
# Haiku: más barato, rápido, ideal para demo y tests batch
CLAUDE_MODEL=claude-haiku-4-5
# Sonnet: más preciso pero ~5-10× más caro (descomentar si lo necesitas)
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Gemini (alternativa) ──────────────────────────────────────────
# Obtener key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=tu_api_key_aqui
