# RECI — Variables de entorno para la demo
# Copiar este archivo a .env y completar los valores:
#   cp .env.example .env

# ── Proveedor de visión ───────────────────────────────────────────
# claude | gemini  (si no se define, usa Claude si hay ANTHROPIC_API_KEY)
VISION_API=claude

# ── Claude (recomendado para la demo) ─────────────────────────────
# Obtener key: https://console.anthropic.com/
# Mínimo de recarga: $5
ANTHROPIC_API_KEY=tu_api_key_aqui
# Sonnet: RECOMENDADO para la demo — Haiku confunde latas con botellas
# (marca Coca-Cola en lata → botella_gaseosa) y duda con Gatorade de vidrio.
# Verificado jul 2026: Sonnet clasificó 39/39 capturas de cámara sin errores.
CLAUDE_MODEL=claude-sonnet-4-6
# Haiku: ~5× más barato y algo más rápido, pero solo para pruebas de flujo
# CLAUDE_MODEL=claude-haiku-4-5

# ── Gemini (alternativa) ──────────────────────────────────────────
# Obtener key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=tu_api_key_aqui
